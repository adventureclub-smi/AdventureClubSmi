// ===== Recruitment =====

// One row per recruitment cycle (e.g. "2026-27") rather than a true
// singleton — exactly one row has isCurrent: true at a time (the live
// cycle, shown on the public form and edited from the admin panel); every
// other row is a past cycle kept around as a read-only archive, same
// "current + archive" split as Trek.isHistorical. "The current row" is
// found with findFirst({ where: { isCurrent: true } }) wherever today's
// code used to just take the first (and only) row.
model RecruitmentSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Free-text cycle label an admin types once when starting it (e.g.
  // "2026-27") — same admin-typed convention as Trek.season.
  season String @default("2026-27")

  opensAt DateTime?

  closesAt DateTime?

  // Free-text options an admin types in each cycle (e.g. "Monday, 31st
  // October") rather than a fixed enum — interview dates change every
  // recruitment round.
  interviewDayOptions String[] @default([])

  // Same dry-run convention as Trek.isTest/testVisibleToUserIds — while true,
  // the banner/form is hidden from everyone except admins and this whitelist,
  // so a cycle can be rehearsed before it goes live to the whole club.
  isTest Boolean @default(false)

  testVisibleToUserIds String[] @default([])

  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  applications RecruitmentApplication[]
}

model RecruitmentApplication {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Which cycle this application belongs to — lets the same student apply
  // again in a later year instead of being locked out forever after their
  // first-ever application, which is what a bare userId @unique meant.
  settingsId String              @db.ObjectId
  settings   RecruitmentSettings @relation(fields: [settingsId], references: [id])

  // Portfolio/work experience — any combination of these three is fine,
  // except applicants ranking Visual Media or Marketing need at least one
  // (enforced in the API route, not here — Mongo has no CHECK constraints).
  portfolioText String?

  portfolioLink String?

  portfolioFileUrl String?

  whyJoin String

  interviewDay String

  // Ordered, index 0 = 1st preference. Max 3, enforced in the API route.
  teamPreferences String[]

  submittedAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ===== Decision =====

  decisionStatus RecruitmentDecisionStatus @default(PENDING)

  // Set the moment the "you're in / not this time" email actually goes
  // out — lets the admin panel show whether an applicant's already been
  // notified, distinct from just having a decision recorded.
  decisionEmailSentAt DateTime?

  @@unique([userId, settingsId])
}

