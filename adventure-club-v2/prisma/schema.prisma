generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum RegistrationStatus {
  WAITING
  APPROVED
  WAITLIST
  REJECTED
  TIMED_OUT
  COMPLETED
  MISSED
}

enum PaymentType {
  INITIAL
  SECOND
  FINAL
}

enum PaymentStatus {
  LOCKED
  PENDING
  PAID
}

enum RefundStatus {
  PENDING
  COMPLETED
}

enum RecruitmentDecisionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentMethod {
  ONLINE
  CASH
  UPI
  BANK_TRANSFER
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  clubId String @unique

  fullName String

  email String @unique

  // A student can't edit their own email by default (guards against typos
  // that would otherwise silently lock them out of their own inbox/notices)
  // — an admin has to unlock it first, the student makes the correction,
  // then the admin locks it again. Defaults true so this ships without
  // opening every existing account up to email changes.
  emailLocked Boolean @default(true)

  // Set the moment a student actually saves a different email while
  // unlocked — drives the admin notification ("they changed it, come
  // review") and clears back to null the moment an admin re-locks, so the
  // notification resolves itself exactly when the workflow says it should.
  emailChangedAt DateTime?

  phoneNumber String @unique

  institution String

  department String

  course String?

  year String

  password String

  role String @default("member")

  createdAt DateTime @default(now())

  registrations Registration[]

  // One per recruitment cycle they've applied to — see RecruitmentSettings
  // below for why this is no longer a single optional relation.
  recruitmentApplications RecruitmentApplication[]

  eventRegistrations EventRegistration[]

  contactSubmissions ContactSubmission[]

  membershipStatus String @default("PENDING")

  clubRole String @default("Pending")

  // Admin panel sub-permission tier: NONE | FULL | FINANCE | VISUAL | BOOKING
  adminAccessLevel String @default("NONE")

  bloodGroup String?

  dateOfBirth DateTime?

  // Calendar year the "Happy Birthday" email was last sent for — guards
  // against re-sending on every subsequent homepage visit that piggybacks
  // the birthday check once this year's wish has already gone out. Year
  // (not a full timestamp) is all that matters since the check only cares
  // "have we already wished them this year", not exactly when.
  lastBirthdayEmailYear Int?

  collegeRollNumber String?

  // Self-uploaded profile picture — shown on the member's own Profile page
  // and in the members-only Directory. Separate from TribeMember.photoUrl,
  // which is an admin-curated photo for the public /tribe page and has no
  // connection to the account itself.
  avatarUrl String?

  // Free-text intro shown on this member's directory profile card.
  bio String?

  // Whether trek stats (completed treks, points, highest peak, etc.) show
  // on this member's directory profile card for other members. Off by
  // default — a member opts in before their activity numbers are visible
  // to anyone but themselves; name/photo/role/bio stay visible either way.
  statsPublic Boolean @default(false)

  emergencyContactName String?

  emergencyContactRelation String?

  emergencyContactPhone String?

  upiId String?

  upiPhone String?

  // =========================
  // Government ID Verification
  // =========================

  govtIdType String?

  govtIdNumber String?

  govtIdImageUrl String?

  govtIdStatus String @default("NOT_SUBMITTED")

  govtIdLocked Boolean @default(false)

  govtIdSubmittedAt DateTime?

  govtIdVerifiedAt DateTime?
}

model Trek {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // "TREK" (default) or "WORKSHOP" — on-campus workshops (tent pitching,
  // etc.) reuse this same model/registration/payment/countdown machinery
  // instead of a parallel system, since they need exactly the same
  // mechanics minus most of the trek-specific fields below (which get
  // harmless placeholder values for a workshop row — see /api/workshops).
  type String @default("TREK")

  // Only meaningful when type is "WORKSHOP" — "WORKSHOP" (default) or
  // "SESSION". Purely a display label an admin picks at creation (e.g.
  // "Bird Watching"/"Bouldering" as a Session vs "Photography Basics" as a
  // Workshop) — everything else (free-entry rules, the WhatsApp tab,
  // payment/bond-form skipping, admin tabs) stays identical between the two,
  // since both are still type "WORKSHOP" underneath.
  activityType String @default("WORKSHOP")

  title String

  destination String

  trailType String

  difficulty String

  altitude String

  duration String

  // Display-only time-of-day text for workshops (e.g. "3:00 PM - 5:00 PM").
  // Kept separate from `date` (which stays a plain calendar date, same as
  // treks) rather than folding it into one timestamp — treks don't track
  // time-of-day either, so this only ever gets set for workshops.
  time String?

  distance String

  // Portfolio Automation
  distanceKm Float @default(0)

  altitudeMeters Int @default(0)

  campNights Int @default(0)

  countsAsPeak Boolean @default(true)

  trekDay String

  date DateTime

  // ===== Historical Archive =====
  // Past treks backfilled from pre-website records — kept out of the
  // current/live trek views and every global cross-trek admin page, only
  // visible in their own season's archive section and their own tabs.

  isHistorical Boolean @default(false)

  season String?

  // ===== Map Location =====
  // Optional coordinates for the homepage trek map — treks without these
  // simply don't render a pin, no backfill required.

  latitude Float?

  longitude Float?

  price Int

  // Set at creation (or later from the edit form) — shown as a highlighted
  // badge right on the registration page, before anyone signs up, since
  // whether they need to sort their own way there/back is a real factor in
  // deciding to register. Distinct from transportDetails below, which is
  // the free-text logistics an admin fills in later for Trip Centre (pickup
  // point, timing, etc.) once the trip is actually confirmed.
  transportIncluded Boolean @default(false)

  // Same spirit as transportIncluded above — an admin-set flag shown as its
  // own highlighted badge on the registration page for a trip that actually
  // has a campfire night, rather than inferring it from free text.
  bonfireIncluded Boolean @default(false)

  // 1 = pay the whole trek cost in one go (finalPayment stays 0, and the
  // single payment auto-completes both the initial and final payment flags
  // once verified — see the payments/verify and payments/offline routes).
  // 2 = the existing initial-then-final split.
  // 3 = initial + second + final — secondPayment is only meaningful here;
  // it stays 0 for 1- and 2-installment treks the same way finalPayment
  // stays 0 for a 1-installment one.
  installments Int @default(2)

  initialPayment Int

  secondPayment Int @default(0)

  finalPayment Int

  coverImage String?

  seats Int

  description String

  itinerary String?

  requiredItems String[]

  optionalItems String[]

  leaderMessage String?

  transportDetails String?

  weatherNote String?

  reportingInstructions String?

  // =========================
  // Trip Centre
  // =========================

  meetingPoint String?

  meetingTime DateTime?

  whatsappGroupLink String?

  emergencyNumber String?

  tripCentrePublished Boolean @default(false)

  tripCentrePublishedAt DateTime?

  // =========================
  // College Reimbursement
  // =========================

  // Set explicitly at creation (or later, from the Refunds tab) — not every
  // trip gets college reimbursement, so this is what actually gates showing
  // "Reimbursement Pending" to students at all. Previously inferred purely
  // from trip-over + something-paid, which showed it for every trip
  // regardless of whether reimbursement was ever on offer.
  reimbursementOffered Boolean @default(false)

  expectedReimbursementMin Int?

  expectedReimbursementMax Int?

  // =========================

  refundPercentage Int?

  status String @default("Registration Open")

  registrationOpensAt DateTime?

  registrationClosesAt DateTime?

  // Only meaningful for a Campus Event (type "EVENT") — the actual kickoff
  // moment (date + time), set on the event's own form alongside the
  // date-only `date` field above. Powers the homepage's pre-tournament
  // countdown (UpcomingEventCountdown) — left null, that section simply
  // has nothing to count down to and doesn't render.
  eventStartsAt DateTime?

  registrationOpenedManually Boolean @default(false)

  registrationClosedManually Boolean @default(false)

  // Early access for the core team — layers on top of the normal open/
  // closed state instead of replacing it. A core-team member (any clubRole
  // other than Member/Registered Member/Participant/Pending — see
  // isCoreTeamRole) can register while this is true even though the trek
  // is still NOT_OPEN/CLOSED for everyone else.
  registrationOpenForCoreOnly Boolean @default(false)

  // Set once the "registrations are open" email has been sent to everyone
  // who clicked Notify Me for this trek — guards against re-sending on
  // every subsequent page view that piggybacks the open-detection check.
  registrationOpenNotifiedAt DateTime?

  createdAt DateTime @default(now())

  registrations Registration[]

  gallery Gallery[]

  expenses Expense[]

  incomes Income[]

  announcements TripAnnouncement[]

  waypoints TrekWaypoint[]

  // A pre-recorded flythrough clip covering the same waypoints, shown on
  // the homepage instead of the live 3D terrain map — that map loads
  // hundreds of satellite/DEM tiles per visitor, while this is one cached
  // video. Falls back to the live map when unset.
  routePreviewVideoUrl String?

  // ===== Test Mode =====
  // Admin-only dry-run treks — hidden from the homepage, the public /treks
  // listing, and every student's dashboard/detail page except the specific
  // students whitelisted below. Admins always see these (tagged TEST) so a
  // trek can be dress-rehearsed before it goes live to the whole club.

  isTest Boolean @default(false)

  testVisibleToUserIds String[] @default([])

  // ===== Draft Mode =====
  // Every trek/workshop starts here (set unconditionally by the create
  // routes, never a client-chosen option) so there's a window to get the QR
  // code/poster ready before announcing it — hidden from the homepage, the
  // public /treks listing, and every regular member's dashboard, but still
  // visible to admins and core team (isCoreTeamRole) so they can preview the
  // page and grab its link/QR. "Go Live" (src/app/api/admin/treks/go-live)
  // is the only thing that flips this to false — that's also the moment the
  // "New Trek/Workshop Announced" email actually goes out, not creation.
  //
  // Same Mongo caveat as isTest above: every trek document must actually
  // store this field for the `isDraft: false` filter to match it. A one-off
  // backfill set it on every pre-existing trek when this field was added.

  isDraft Boolean @default(false)

  // ===== Registration Eligibility =====
  // Empty = open to every year, same "empty means unrestricted" convention
  // as testVisibleToUserIds above. Values are the canonical strings from
  // src/lib/academic-options.ts's YEARS array ("1st Year", "2nd Year", ...) —
  // the trek itself and everyone's own year stay visible as normal either
  // way; this only gates who's allowed to register.
  restrictedYears String[] @default([])

  // ===== Trek Photos =====
  // Admin pastes a Google Drive folder share link here (created and shared
  // manually in Drive itself, e.g. "Anyone with the link" as Editor/
  // Contributor so students can drop their own photos in) — the site just
  // links out to it rather than handling uploads/storage itself.
  photosLink String?

  // =========================
  // Campus Events (Tug of War, etc.)
  // =========================
  // Only meaningful when type is "EVENT" — same placeholder-field convention
  // as WORKSHOP above. An on-campus team event: students register
  // individually (no buddy/group sign-up — teams are never decided by this
  // site). Teams are formed physically on the day via chit picking from a
  // bag; the website draws them automatically instead — one click, equally
  // sized, randomly coloured. See src/lib/event-draw.ts,
  // src/lib/event-groups.ts and src/lib/event-playoff.ts.

  // Target players per team — how many teams the draw creates is derived
  // from total registrations / this number.
  eventTeamSize Int?

  // Top 4 advance from the league table into the page playoff (Qualifier/
  // Eliminator/Qualifier 2/Final — see event-playoff.ts). Fixed at 4 by
  // that format, so this field exists mainly for display; only meaningful
  // for eventFormat "LEAGUE_KNOCKOUT".
  eventQualifiersCount Int?

  // Caps how many opponents each team plays in the league stage — e.g. 8
  // teams with a cap of 5 means every team plays a random 5 of the other 7,
  // not a full round robin, all within one combined table (no separate
  // groups). See event-groups.ts's generateLeagueSchedule. Only meaningful
  // for eventFormat "LEAGUE_KNOCKOUT".
  eventMatchesPerTeamCap Int?

  // "LEAGUE_KNOCKOUT" (group stage feeding a seeded knockout bracket) or
  // "DIRECT_KNOCKOUT" (teams go straight into a knockout bracket, no group
  // stage) — chosen by organisers once attendance/team count is known, so
  // it stays editable right up until teams are locked.
  eventFormat String @default("LEAGUE_KNOCKOUT")

  // Set once the admin locks team allocation (after recording every
  // participant's physically-drawn team) — fixtures get generated at that
  // point and no further team assignment or registration is allowed.
  eventTeamsDrawnAt DateTime?

  // A seed logged at lock time, used only for reproducible/auditable
  // points-table tiebreaks — never for deciding team membership.
  eventDrawSeed String?

  // Flips true from one admin action ("Close Registrations & Start
  // Tournament" — see /api/events/[id]/start-tournament) that also sets
  // registrationClosedManually. Until then the admin can draw teams, play
  // with fixtures and record results freely to test the setup, but none of
  // it — teams, fixtures, standings — is visible on the public event page
  // or the TV display; everyone but admins/core team sees registration is
  // still open and nothing else. Missing/false on every event created
  // before this field existed, which is the correct default (hidden).
  eventTournamentStarted Boolean?

  // Set from the admin's "Feature on Homepage" toggle (see
  // /api/events/[id]/feature) — shows this event's live teams/standings in
  // the homepage's Live League section, right under the Hero. Only one
  // event is ever featured at a time: turning this on for one event turns
  // it off for every other. Meaningless (and ignored by the homepage
  // route) unless eventTournamentStarted is also true, since nothing about
  // teams/fixtures is public before then anyway.
  eventFeaturedOnHomepage Boolean?

  eventRegistrations EventRegistration[]

  eventTeams EventTeam[]

  eventMatches EventMatch[]
}

// Individual sign-up for a type:"EVENT" Trek — deliberately separate from
// Registration, which carries dozens of fields (payments, bond form, trip
// centre, certificates...) that mean nothing for a free on-campus event and
// would otherwise leak into every admin page that broadly queries
// Registration (Payments, Finance, Certificates...).
model EventRegistration {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  trekId String @db.ObjectId
  trek   Trek   @relation(fields: [trekId], references: [id])

  // Null for a guest registration (see below) — a logged-in club member's
  // sign-up always has this set.
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  // Guest registration — for attendees without a club account (other
  // colleges, walk-ins). Collected directly on the form instead of resolving
  // a User. Only meaningful when userId is null.
  isGuest Boolean @default(false)
  guestName String?
  guestPhone String?
  guestCollege String?
  guestRollNo String?
  guestDepartment String?
  guestYear String?

  // Collected at registration time for every sign-up, club member and guest
  // alike — not pulled from the User profile, since no such field exists
  // there and asking fresh here is simpler than backfilling every account.
  // "Male" | "Female" | "Other". Editable afterwards from the Present List
  // (PATCH .../registrations/[registrationId]) for anyone who skipped it or
  // was entered wrong. Used only so the team draw (event-draw.ts) can
  // balance each team's gender split; nothing else reads it.
  gender String?

  // An admin's pick, per event — not tied to the person's actual club role
  // (a guest can be marked core same as a club member), set from the
  // Present List. The draw spreads these as evenly across teams as the
  // count allows (same spirit as the gender split, and balanced by gender
  // within the core group too) — e.g. a handful of experienced members the
  // admin wants seeded one-or-two-per-team rather than left to pure chance.
  isCoreMember Boolean @default(false)

  teamId String?    @db.ObjectId
  team   EventTeam? @relation(fields: [teamId], references: [id])

  // A short, easy-to-read per-event number assigned the moment someone
  // registers ("01", "02", ...; grows past 2 digits if an event ever needs
  // it) — shown next to their QR code so a check-in desk can type it in by
  // hand just as easily as scanning it. Starts back at 01 for every event,
  // unlike Registration.registrationNumber which is global for the year.
  shortCode String

  // ===== Check-in (on the event day) =====
  // Separate from Attendance (which is Trek/Registration-specific) for the
  // same reason EventRegistration itself is separate from Registration.

  attendanceMarked Boolean @default(false)

  attendanceMarkedAt DateTime?

  // Free-text name of whichever admin/core member checked them in — same
  // plain-string convention as Registration.approvedBy, not a relation.
  attendanceMarkedBy String?

  createdAt DateTime @default(now())

  // Not a DB-level unique constraint on [trekId, userId] — userId is null
  // for every guest registration, and a unique index would treat all of
  // those nulls as duplicates. "One registration per logged-in user per
  // event" is instead checked in the register API before creating.
  @@index([trekId, userId])
  @@unique([trekId, shortCode])
}

model EventTeam {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  trekId String @db.ObjectId
  trek   Trek   @relation(fields: [trekId], references: [id])

  name String

  // Wristband/chit colour, e.g. "Red", "Blue" — set by the admin when the
  // team is created, shown as a swatch everywhere the team appears.
  colour String

  // How many chits to print for this team — set by the admin once final
  // attendance is known, purely to plan printing; never used to decide who
  // goes where.
  targetSize Int @default(0)

  // Which group this team was placed in for the group stage — only matters
  // once there's more than one group (see Trek.eventMatchesPerTeamCap); null
  // when the whole event fits in a single round robin.
  groupNumber Int?

  // Standing within its group once the group stage finishes, used to seed
  // the knockout bracket (1 = top of its group). Null until computed.
  seed Int?

  createdAt DateTime @default(now())

  registrations EventRegistration[]

  matchesAsTeamA EventMatch[] @relation("EventMatchTeamA")
  matchesAsTeamB EventMatch[] @relation("EventMatchTeamB")
}

model EventMatch {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  trekId String @db.ObjectId
  trek   Trek   @relation(fields: [trekId], references: [id])

  // "GROUP" | "KNOCKOUT"
  stage String

  // Only meaningful for stage "GROUP" — every league-stage match currently
  // belongs to one combined table (see event-groups.ts's schedule
  // generator, which caps matches per team without splitting into separate
  // groups), so this is always null in practice; kept nullable rather than
  // removed in case a future format reintroduces real groups.
  groupNumber Int?

  // Only meaningful for stage "KNOCKOUT" — the page-playoff round names
  // "QUALIFIER" | "ELIMINATOR" | "QUALIFIER_2" | "FINAL" (see
  // src/lib/event-playoff.ts), or the generic single-elimination round
  // names from event-bracket.ts when the event's format is
  // DIRECT_KNOCKOUT instead.
  round String?

  teamAId String    @db.ObjectId
  teamA   EventTeam @relation("EventMatchTeamA", fields: [teamAId], references: [id])

  // Null means a bye — teamA advances automatically, no match is actually
  // played (only possible in a DIRECT_KNOCKOUT first round, when the
  // qualifier count isn't already a power of two). See
  // src/lib/event-bracket.ts. The page-playoff format never has byes.
  teamBId String?    @db.ObjectId
  teamB   EventTeam? @relation("EventMatchTeamB", fields: [teamBId], references: [id])

  // Every match is played as two rounds — each round has a clear winner
  // (never a tie). These two fields are the actual recorded result;
  // teamAScore/teamBScore (rounds won, 0-2) and winnerTeamId are derived
  // from them when the result is saved, not entered directly.
  round1WinnerId String?
  round2WinnerId String?

  // Rounds won by each team (0, 1 or 2) — derived from round1Winner/
  // round2Winner, kept as plain fields so every existing "(2-1)"-style
  // score display keeps working unchanged.
  teamAScore Int?
  teamBScore Int?

  // Null means a draw (each team won one round) — only ever possible for
  // a GROUP-stage match. A KNOCKOUT match that splits 1-1 requires the
  // admin to additionally record a tie-break winner here instead, since a
  // playoff match can never advance as a draw.
  winnerTeamId String?

  // "SCHEDULED" | "COMPLETED"
  status String @default("SCHEDULED")

  createdAt DateTime @default(now())
}

// Admin-editable waypoints (trailhead, halfway point, summit, etc.) that
// drive the homepage's in-page 3D terrain preview for upcoming treks — a
// trek only appears in that picker once it has at least one waypoint set.
model TrekWaypoint {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  trekId String @db.ObjectId
  trek   Trek   @relation(fields: [trekId], references: [id])

  label String

  description String?

  latitude Float

  longitude Float

  mediaUrl String?

  mediaType String @default("image")

  order Int @default(0)

  createdAt DateTime @default(now())
}

model Registration {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  registrationNumber String @unique

  // Student
  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  // Guest
  isGuest Boolean @default(false)

  guestName        String?
  guestRollNo      String?
  guestEmail       String?
  guestInstitution String?
  guestDepartment  String?
  guestCourse      String?
  guestYear        String?
  guestPhoneNumber String?

  // Trek
  trekId String @db.ObjectId
  trek   Trek   @relation(fields: [trekId], references: [id])

  // Registration
  status RegistrationStatus @default(WAITING)

  approvedBy String?
  approvedAt DateTime?

  initialPaymentDeadline DateTime?

  remarks String?

  // ===== Initial Payment =====

  initialPaymentPaid Boolean @default(false)

  initialPaymentPaidAt DateTime?

  initialPaymentId String?

  // Explicitly recorded as never paid (distinct from just not-yet-paid) —
  // mainly for historical trek records where there's no one left to chase.
  initialPaymentDidNotPay Boolean @default(false)

  // Set the moment the trek's WhatsApp group invite email goes out — fires
  // once, right when an admin verifies (or records) this student's initial
  // payment. Guards against re-sending on a later undo/re-verify.
  whatsappInviteSentAt DateTime?

  // There's no API to check WhatsApp group membership — an admin has to
  // open the group on their phone and cross-check the member list by eye,
  // then flip this manually. Purely a bookkeeping flag, independent of
  // whether the invite email itself was ever sent.
  whatsappGroupJoined Boolean @default(false)

  // ===== Second Payment (installments === 3 only) =====

  secondPaymentUnlocked Boolean @default(false)

  secondPaymentPaid Boolean @default(false)

  secondPaymentPaidAt DateTime?

  secondPaymentId String?

  // Explicitly recorded as never paid (distinct from just not-yet-paid) —
  // mainly for historical trek records where there's no one left to chase.
  secondPaymentDidNotPay Boolean @default(false)

  // ===== Bond Form =====

  bondFormSubmitted Boolean @default(false)

  bondFormSubmittedAt DateTime?

  // ===== Attendance =====

  attendanceMarked Boolean @default(false)

  attendanceMarkedAt DateTime?

  // Explicitly recorded as absent (distinct from just not-yet-checked) —
  // same "DidNotPay"-style convention as the payment flags above. Mutually
  // exclusive with attendanceMarked: marking one true clears the other.
  // Trek completion's own "present vs missed" split still just reads
  // !attendanceMarked either way, so this is purely for the admin's own
  // record of "checked and absent" vs "never got checked at all."
  attendanceAbsent Boolean @default(false)

  // ===== Final Payment =====

  finalPaymentUnlocked Boolean @default(false)

  finalPaymentPaid Boolean @default(false)

  finalPaymentPaidAt DateTime?

  finalPaymentId String?

  // Explicitly recorded as never paid (distinct from just not-yet-paid) —
  // mainly for historical trek records where there's no one left to chase.
  finalPaymentDidNotPay Boolean @default(false)

  // The full trek cost was collected in one lump sum during the initial
  // payment, so there's no separate final-payment transaction to record.
  finalPaymentPaidAtOnce Boolean @default(false)

  // ===== College Reimbursement =====

  reimbursementAmount Int?

  reimbursementDone Boolean @default(false)

  reimbursementDoneAt DateTime?

  reimbursementReceived Boolean @default(false)

  reimbursementReceivedAt DateTime?

  // ===== Certificate =====

  certificateIssued Boolean @default(false)

  certificateIssuedAt DateTime?

  // timestamps

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Relations

  payments Payment[]

  refunds Refund[]

  attendance Attendance?

  emergencyContact EmergencyContact?

  certificate Certificate?

  // Offline payment support
  offlinePaymentCreated Boolean @default(false)

  offlinePaymentVerified Boolean @default(false)

  paymentMethod String?

  paymentReference String?

  paymentAmount Int?

  paymentRecordedAt DateTime?

  paymentRecordedBy String?

  paymentPortal Boolean @default(false)

  // =========================
  // Booking (Govt Permits)
  // =========================

  bookingAssignedTo String?

  // Lets an admin correct how a name is spelled for the govt permit
  // without touching the person's actual account name — display-only,
  // scoped to this registration/the booking page.
  bookingNameOverride String?

  // =========================
  // Payments (admin visibility)
  // =========================

  // Hides this registration from the admin Payments section (list, stats,
  // bulk unlocks) without touching the registration itself — it still
  // shows normally in Registrations. For someone who registered but isn't
  // actually going, so they stop cluttering the payments list. Reversible
  // from the same "Removed" filter in that section.
  hiddenFromPayments Boolean @default(false)
}

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  registrationId String       @db.ObjectId
  registration   Registration @relation(fields: [registrationId], references: [id])

