# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# large raw video assets — everything in here is unused raw footage
# except the files below: the two web-optimized hero/drone background
# videos served in production, and a static poster frame for the hero
# video (shown if playback ever fails on a device/network, instead of
# Chrome's broken-video icon).
/public/videos/*
!/public/videos/hero-compressed.mp4
!/public/videos/drone-compressed.mp4
!/public/videos/hero-poster.jpg

.vercel

# raw trek Excel sheets used for one-off historical-data imports — contain
# real student names/phone numbers, kept local only, never committed
/trek-data/*.xlsx
/trek-data/*.xls

# one-off zip drops from teammates (source bundles, asset packs) — never
# meant to be committed, just extracted from locally
*.zip

# local tool/editor config — machine-specific, not shared
.claude/
.vscode/
